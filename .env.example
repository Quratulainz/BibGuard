# Copy to .env (or just run: python setup_wizard.py). Never share the real .env file.
SECRET_KEY=put-a-long-random-text-here
ADMIN_KEY=choose-a-password
CONTACT_EMAIL=you@mail.com
BASE_URL=http://localhost:5000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your16letterapppassword
SMTP_FROM=BibGuard <you@gmail.com>
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAY_CURRENCY=usd
PACK_PRICE_CENTS=300
PACK_FILES=30
FREE_FILES_PER_DAY=1
USER_FREE_TOTAL=5
# Lemon Squeezy (only if PayPal is not available in your country)
LEMON_CHECKOUT_URL=
LEMON_WEBHOOK_SECRET=
# Verify emails without sending email: Google sign-in
GOOGLE_CLIENT_ID=
# Email by API (alternative to Gmail SMTP)
BREVO_API_KEY=
BREVO_SENDER=

# Free beta is the default. Enable only after testing a payment provider.
CREDITS_ENABLED=0
BETA_DAILY_FILES=5
# Public deployment: set HTTPS=1 and BASE_URL to the public HTTPS origin.
# TRUSTED_PROXY_HOPS=0
# OPENALEX_API_KEY=
